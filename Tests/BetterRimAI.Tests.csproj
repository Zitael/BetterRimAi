<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pure tests: threat geometry and decision rules. No RimWorld types are used at runtime, so
    these run anywhere, including against RimWorld reference assemblies.
    Tests that need the real game assemblies live in ../Tests.RimWorld.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Source\BetterRimAI.csproj" AdditionalProperties="RimWorldDir=$(RimWorldDir)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
